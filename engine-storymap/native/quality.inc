 cgDesired=next;cgPending=cgDesired!=cg4k;cgRetries=0;cgRetryAt=0;SetWindowTextW(qualityButton,QualityLabel());InvalidateRect(qualityButton,nullptr,FALSE);if(logFile){fprintf(logFile,"cg_option quality=%s pending=1\n",cgDesired?"4k":"base");fflush(logFile);}
