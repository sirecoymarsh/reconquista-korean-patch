static HWND qualityButton=nullptr;static WNDPROC oldQualityProc=nullptr;static const UINT QUALITY_ID=0x7e44;
static LRESULT CALLBACK QualityProc(HWND h,UINT m,WPARAM w,LPARAM l){if((m==WM_KEYDOWN||m==WM_KEYUP||m==WM_SYSKEYDOWN||m==WM_SYSKEYUP)&&w!=VK_SPACE)return SendMessageW(GetParent(h),m,w,l);auto r=CallWindowProcW(oldQualityProc,h,m,w,l);if((m==WM_LBUTTONUP||m==WM_CAPTURECHANGED||m==WM_CANCELMODE)&&GetFocus()==h)SetFocus(GetParent(h));return r;}
