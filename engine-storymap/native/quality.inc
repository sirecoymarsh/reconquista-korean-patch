static void QualityStatus(){if(qualityButton){SetWindowTextW(qualityButton,QualityLabel());InvalidateRect(qualityButton,nullptr,FALSE);}}
static void SyncQualityButton(){HWND parent=Game();if(!parent)return;if(!ReviewButtonWanted()){if(qualityButton){if(GetFocus()==qualityButton)SetFocus(parent);ShowWindow(qualityButton,SW_HIDE);}return;}
 if(!qualityButton){qualityButton=CreateWindowExW(0,L"BUTTON",QualityLabel(),WS_CHILD|WS_TABSTOP|BS_OWNERDRAW,0,0,1,1,parent,(HMENU)(UINT_PTR)QUALITY_ID,GetModuleHandleW(nullptr),nullptr);if(qualityButton)oldQualityProc=(WNDPROC)SetWindowLongPtrW(qualityButton,GWLP_WNDPROC,(LONG_PTR)QualityProc);}if(!qualityButton)return;if(cgApplyFailed){wchar_t label[64]{};GetWindowTextW(qualityButton,label,64);if(wcscmp(label,QualityLabel()))QualityStatus();}
 auto v=Viewport(parent);int x=v.x+MulDiv(205,v.w,800),y=v.y+MulDiv(55,v.h,600),w=MulDiv(165,v.w,800),h=MulDiv(25,v.h,600);RECT r{};GetWindowRect(qualityButton,&r);MapWindowPoints(nullptr,parent,(POINT*)&r,2);
 if(r.left!=x||r.top!=y||r.right-r.left!=w||r.bottom-r.top!=h){SetWindowPos(qualityButton,HWND_TOP,x,y,w,h,SWP_NOACTIVATE);int cut=std::max(3,h/5);POINT pts[]={{cut,0},{w-cut,0},{w,h/2},{w-cut,h},{cut,h},{0,h/2}};auto region=CreatePolygonRgn(pts,6,WINDING);if(region&&!SetWindowRgn(qualityButton,region,TRUE))DeleteObject(region);}
 SendMessageW(qualityButton,WM_SETFONT,(WPARAM)reviewFont,FALSE);if(!(GetWindowLongW(qualityButton,GWL_STYLE)&WS_VISIBLE))ShowWindow(qualityButton,SW_SHOWNOACTIVATE);
}
static void DrawQualityButton(const DRAWITEMSTRUCT* di){int saved=SaveDC(di->hDC);RECT r=di->rcItem;auto brush=CreateSolidBrush((di->itemState&ODS_SELECTED)?RGB(126,57,70):cg4k?RGB(103,37,54):RGB(48,24,36));auto pen=CreatePen(PS_SOLID,std::max<int>(1,r.bottom/25),RGB(185,128,135));FillRect(di->hDC,&r,brush);auto ob=SelectObject(di->hDC,brush),op=SelectObject(di->hDC,pen);int cut=std::max<int>(3,r.bottom/5);POINT pts[]={{cut,1},{r.right-cut-1,1},{r.right-1,r.bottom/2},{r.right-cut-1,r.bottom-1},{cut,r.bottom-1},{1,r.bottom/2}};Polygon(di->hDC,pts,6);SelectObject(di->hDC,op);SelectObject(di->hDC,ob);DeleteObject(pen);DeleteObject(brush);if(reviewFont)SelectObject(di->hDC,reviewFont);SetBkMode(di->hDC,TRANSPARENT);SetTextColor(di->hDC,RGB(249,228,214));DrawTextW(di->hDC,QualityLabel(),-1,&r,DT_CENTER|DT_VCENTER|DT_SINGLELINE|DT_NOPREFIX);if(di->itemState&ODS_FOCUS){InflateRect(&r,-cut,-4);DrawFocusRect(di->hDC,&r);}RestoreDC(di->hDC,saved);}
static void ToggleQuality(){if(cgApplyFailed){if(!probe)MessageBoxW(Game(),L"화질 전환에 필요한 이미지를 준비하지 못했습니다.\n진행 내용을 저장하고 게임을 다시 실행해 주세요.",L"CG·메뉴 화질",MB_OK|MB_ICONERROR);return;}wchar_t path[MAX_PATH],tmp[MAX_PATH];swprintf_s(path,L"%s\\cg-quality.ini",root);swprintf_s(tmp,L"%s\\cg-quality.ini.new",root);FILE*f=nullptr;bool next=!cgDesired;bool ok=_wfopen_s(&f,tmp,L"wb")==0&&f;
 if(ok){const char* data=next?"[graphics]\r\ncg_4k=1\r\n":"[graphics]\r\ncg_4k=0\r\n";ok=fwrite(data,1,strlen(data),f)==strlen(data);ok=fclose(f)==0&&ok;if(ok)ok=MoveFileExW(tmp,path,MOVEFILE_REPLACE_EXISTING|MOVEFILE_WRITE_THROUGH)!=FALSE;}
