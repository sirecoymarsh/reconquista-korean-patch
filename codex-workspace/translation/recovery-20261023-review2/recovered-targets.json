      "status": "primary_authored_independent_review_pass_with_referent_correction"
    },
    {
      "id": "masa_15.mjo::001784",
      "unit": "masa_15.mjo::u0149",
      "source": "「あ、ごめんなさい。いたかった？」",
      "target": "「아, 미안해. 아팠어?」",
      "source_sha256": "854aca52576a0462a7d0a3f4c12f3fc0bdeeeb11550a6201a29cd6a6da1843a1",
      "translator_model": "Codex internal",
      "context": {
        "source_speaker": "もみじ",
        "story_phase": "masa_15.mjo",
        "evidence": "u0148,u0150",
        "review_reason": "사과하고 아팠는지 묻는 일반 대사. 접촉을 구체적으로 재현하지 않음."
      },
      "provenance": {
        "root_thread": "01a16283-b393-7dc0-8c83-d3e23a2a2f41",
        "date": "2026-10-23",
        "semantic_author": "primary Codex internal"
