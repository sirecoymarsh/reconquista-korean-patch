    {
      "id": "maho_14.mjo::002403",
      "unit": "maho_14.mjo::u0247",
      "source": "オレは今日もスカートを捲り、",
      "target": "나는 오늘도 치마를 들추고,",
      "source_sha256": "a9424d3caba95a428e65dfbc50f09e469d7b6de485ce5c783b973b8a9047b116",
