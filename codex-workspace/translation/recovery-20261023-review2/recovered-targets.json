    {
      "id": "masa_15.mjo::001711",
      "unit": "masa_15.mjo::u0143",
      "source": "「あはっ、くすぐったい」",
      "target": "「아핫, 간지러워.」",
      "source_sha256": "854aca52576a0462a7d0a3f4c12f3fc0bdeeeb11550a6201a29cd6a6da1843a1",
